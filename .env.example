# ---------------------------------------------------------------- Supabase --
# Project URL. Public by design; it ships in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://fklfyoivcpdopjasjueu.supabase.co

# Publishable key (sb_publishable_...). Dashboard: Settings -> API Keys ->
# "Publishable and secret API keys". Safe in client code: every permission it
# has is decided by the row-level security policies in
# supabase/migrations/0001_init.sql.
#
# Use this, not the legacy `anon` JWT. Supabase is deprecating anon and
# service_role by the end of 2026.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...), same dashboard page. Server-side only. It
# BYPASSES row-level security, so it must never reach the browser, a commit, or
# a chat window. Set it directly in Vercel's environment variables and in a
# local .env.local. Only the HubSpot deal pull needs it.
SUPABASE_SECRET_KEY=

# ----------------------------------------------------------------- HubSpot --
# Private app token. Scope: crm.objects.deals.read and nothing else.
# This app never writes to HubSpot.
HUBSPOT_PRIVATE_APP_TOKEN=

# -------------------------------------------------------------------- site --
# Public origin, used for magic-link redirects.
NEXT_PUBLIC_SITE_URL=https://delivery.belegendary.org
